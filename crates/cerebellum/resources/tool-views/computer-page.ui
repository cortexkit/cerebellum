export const action = input.action == "read_state" ? "Read app" : input.action == "press_element" || input.action == "press_point" ? "Press" : input.action == "write_text" || input.action == "type" ? "Type" : input.action == "keys" ? "Press keys" : input.action == "takeover_move" ? "Move pointer" : input.action == "takeover_drag" ? "Drag" : input.action == "takeover_scroll" ? "Scroll" : input.action == "wait" ? "Wait" : input.action == "list_apps" ? "List apps" : input.action == "open_app" ? "Open app" : Replace(input.action, "_", " ")
export const outcome = view.completion.outcome ?? view.record.outcome
export const reason = view.completion.outcome == null ? view.record.reason : view.completion.reason
export const reasonText = reason == "screen_locked" ? "Screen locked" : reason == "element_disabled" ? "Button disabled" : reason == "point_in_another_window" ? "Point in another window" : reason == "consent_declined" ? "Declined" : reason == "consent_expired" ? "Approval expired" : reason == "state_changed_by_person" ? "You were using the app" : reason == "operator_app_blocked" ? "App not allowed" : reason == "consent" ? "Approval asked" : reason == "login_handoff" ? "Not signed in" : reason == "scope_ended" ? "Run ended" : reason == "cancelled" ? "Cancelled" : reason == "outcome_unknown" ? "Outcome unknown" : "Another reason"
export const status = outcome == "held" ? (reason == "login_handoff" ? "Not signed in" : "Approval asked") : outcome == "error" ? "Refused" : outcome == "partial" ? "Outcome unknown" : outcome == "success" ? "Done" : view.call.phase == "running" ? "Running" : "No outcome kept"
export const duration = view.completion.durationMs ?? view.record.durationMs
export const queued = view.completion.queuedMs ?? view.record.queuedMs ?? 0
export const held = view.completion.heldMs ?? view.record.heldMs ?? 0
export const posts = view.completion.postsReturned ?? view.record.postsReturned
export const target = input.target ?? input.app ?? view.completion.app ?? view.record.app ?? ""
export const appName = !Contains(target, " ") && Contains(target, ".") ? Last(Split(target, ".")) : target

<CardHeader title={action} subtitle={appName} />
<Card appearance="clear" gap="xs">
<TextContent text={"Outcome: " + status} size="small" />
{reason == null ? null : <TextContent text={"Reason: " + reasonText} size="small" />}
{reason != null && reasonText == "Another reason" ? <Styled tone="muted">{reason}</Styled> : null}
{duration == null ? (view.call.phase == "running" ? <Elapsed start={view.call.startedAtMs ?? now} /> : null) : <TextContent text={"Duration: " + FormatDuration(duration)} size="small" />}
{queued > 0 ? <TextContent text={"Waited in line: " + FormatDuration(queued)} size="small" /> : null}
{held > 0 ? <TextContent text={"Waited for you: " + FormatDuration(held)} size="small" /> : null}
{posts == null ? null : <TextContent text={"Input events sent: " + Text(posts)} size="small" />}
{input.action == "read_state" && input.bring_to_front == true ? <TextContent text="Brought to the front for a picture" size="small" /> : null}
</Card>

{input.action == "type" || input.action == "write_text" ? <CardHeader title="Typed text" /> : null}
{input.action == "type" || input.action == "write_text" ? <CodeBlock codeString={input.text ?? ""} /> : null}
