# Alfonso + fleet session artifacts (drafts, task outputs, historian, context) —
# never repo content. A fired spec draft writes into .cortexkit/alfonso/drafts/
# (.cortexkit/prefrontal/drafts/ after the rename); without this ignore it
# dirties the parent repo and blocks every mason worktree dispatch. The nested
# negations keep a future rules/ folder tracked under either name.
.cortexkit/*
!.cortexkit/alfonso/
.cortexkit/alfonso/*
!.cortexkit/alfonso/rules/
!.cortexkit/prefrontal/
.cortexkit/prefrontal/*
!.cortexkit/prefrontal/rules/

# AFT-generated codebase analysis docs (regenerated from source, not authored) —
# kept out of the repo so generated content never churns the tree.
ARCHITECTURE.md
STRUCTURE.md

# Internal design material stays out of the repository by policy.
docs/design/
docs/field-notes.md

# Rust build artifacts.
target/

# Finder metadata. One was committed at the root for a month before the
# fleet gitignore census found it; the rule keeps the next one out.
.DS_Store

# Python writes bytecode caches next to the gate's helper scripts; they are
# never source, and an untracked cache made the gate's "generated files
# untouched by the build" phase fail on a fresh checkout.
__pycache__/
