{
  "manifest_version": 3,
  "name": "CortexKit Agent Tabs",
  "version": "0.2.0",
  "description": "Hand tabs in your signed-in Chrome to CortexKit, and take them back at any time.",
  "minimum_chrome_version": "137",
  "key": "",
  "permissions": ["debugger", "tabGroups", "nativeMessaging", "contextMenus", "storage", "scripting", "webNavigation", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "service-worker.mjs", "type": "module" },
  "action": { "default_title": "Hand this tab to Agent / take it back" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
